# Copy this file to ".env" and fill in the values.
# NEVER commit the real ".env" file (it's already excluded via .gitignore).

# --- Plugin Configuration ---------------------------------------------------
# Directory where the plugin writes event JSONL files.
# Default: ~/.local/state/omp-usage/events
# OMP_USAGE_EVENTS_DIR=

# --- Exporter Configuration -------------------------------------------------
# Directory to scan for event JSONL files (same as plugin default).
# OMP_USAGE_EVENTS_DIR=

# SQLite database path for the exporter.
# Default: ~/.local/state/omp-usage/exporter.db
# OMP_USAGE_DB_PATH=

# HTTP listen address for the exporter.
# Default: 127.0.0.1:9464
# Binding to LAN requires explicit configuration.
# OMP_USAGE_LISTEN=

# Maximum line length when reading JSONL files (bytes).
# Default: 1048576 (1 MiB)
# OMP_USAGE_MAX_LINE_LENGTH=

# Log level: debug, info, warn, error
# Default: info
# OMP_USAGE_LOG_LEVEL=

# Delete event files that are fully imported and idle for N days.
# Default: off (never delete)
# OMP_USAGE_EXPORTER_RETENTION_DAYS=30

# Optional price tables for equivalent-cost dashboards (see docs/pricing.md).
# Default: none (no price metrics, no network access)
# OMP_USAGE_PRICING_FILE=~/.config/omp-usage/pricing.json