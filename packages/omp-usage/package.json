{
  "name": "@tommasomarchionni/omp-usage",
  "version": "0.3.1",
  "description": "OMP plugin for collecting LLM usage events",
  "type": "module",
  "license": "MIT",
  "author": "Tommaso Marchionni",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tommasomarchionni/omp-usage.git",
    "directory": "packages/omp-usage"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "@tommasomarchionni/omp-usage-protocol": "0.1.0"
  },
  "omp": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
