{"name":"omp-usage","version":"0.1.0","private":true,"description":"OMP usage tracking plugin and Prometheus exporter","repository":{"type":"git","url":"https://github.com/tommasomarchionni/omp-usage.git"},"author":"Tommaso Marchionni","license":"MIT","workspaces":["packages/*"],"scripts":{"build":"npm run build --workspace=@tommasomarchionni/omp-usage-protocol && npm run build --workspace=@tommasomarchionni/omp-usage && npm run build --workspace=@tommasomarchionni/omp-usage-exporter","test":"npm run test --workspaces --if-present","lint":"npm run lint --workspaces --if-present","typecheck":"npm run typecheck --workspaces --if-present","format":"prettier --write .","format:check":"prettier --check .","prepare":"husky install","changelog":"conventional-changelog -p angular -i CHANGELOG.md -s -r 0","pack:dry":"npm pack --dry-run --workspaces","docs:serve":"mkdocs serve -f docs/mkdocs.yml","docs:build":"mkdocs build -f docs/mkdocs.yml --strict"},"devDependencies":{"@types/node":"^26.6.5","@typescript-eslint/eslint-plugin":"^8.71.1","@typescript-eslint/parser":"^8.71.1","conventional-changelog-cli":"^5.0.0","eslint":"^8.57.0","eslint-config-prettier":"^10.1.8","husky":"^9.0.0","prettier":"^3.3.0","typescript":"^5.5.0","vitest":"^2.0.0"},"engines":{"node":">=20.0.0"}}