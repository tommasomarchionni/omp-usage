      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(increase(omp_llm_tokens_total{job=~\"$job\", provider=~\"$local_provider\", direction=\"output\"}[$__interval]))",
          "legendFormat": "OMP output",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(increase({__name__=\"llamacpp:tokens_predicted_total\", job=~\"$llm_job\"}[$__interval]))",
          "legendFormat": "llama.cpp predicted",
