{
  "uid": "omp-usage-efficiency",
  "title": "OMP usage / Efficiency",
  "description": "Tokens per request, context size, cache, reasoning and blended price per model.",
  "tags": [
    "omp-usage"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "links": [
    {
      "title": "OMP usage",
      "type": "dashboards",
      "tags": [
        "omp-usage"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "label": "Data source",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "type": "query",
        "name": "job",
        "label": "Job",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(omp_usage_build_info, job)",
        "query": {
          "query": "label_values(omp_usage_build_info, job)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "sort": 1,
        "hide": 0,
        "regex": "",
        "options": [],
        "current": {
          "text": "omp_usage",
          "value": "omp_usage"
        }
      },
      {
        "type": "query",
        "name": "provider",
        "label": "Provider",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(omp_llm_tokens_total{job=~\"$job\"}, provider)",
        "query": {
          "query": "label_values(omp_llm_tokens_total{job=~\"$job\"}, provider)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "sort": 1,
        "hide": 0,
        "regex": "",
        "options": [],
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "type": "query",
        "name": "model",
        "label": "Model",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(omp_llm_tokens_total{job=~\"$job\", provider=~\"$provider\"}, model)",
        "query": {
          "query": "label_values(omp_llm_tokens_total{job=~\"$job\", provider=~\"$provider\"}, model)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "sort": 1,
        "hide": 0,
        "regex": "",
        "options": [],
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "type": "interval",
        "name": "bucket",
        "label": "Bucket",
        "query": "1h,3h,6h,12h,1d,7d,30d",
        "auto": false,
        "auto_count": 30,
        "auto_min": "1h",
        "refresh": 2,
        "hide": 0,
        "current": {
          "text": "1d",
          "value": "1d"
        },
        "options": [
          {
            "text": "1h",
            "value": "1h",
            "selected": false
          },
          {
            "text": "3h",
            "value": "3h",
            "selected": false
          },
          {
            "text": "6h",
            "value": "6h",
            "selected": false
          },
          {
            "text": "12h",
            "value": "12h",
            "selected": false
          },
          {
            "text": "1d",
            "value": "1d",
            "selected": true
          },
          {
            "text": "7d",
            "value": "7d",
            "selected": false
          },
          {
            "text": "30d",
            "value": "30d",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Tokens per request",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (provider, model) (increase(omp_llm_tokens_total{job=~\"$job\", provider=~\"$provider\", model=~\"$model\"}[$__interval]))\n/\nsum by (provider, model) (increase(omp_llm_requests_total{job=~\"$job\", provider=~\"$provider\", model=~\"$model\"}[$__interval]))",
          "legendFormat": "{{provider}} / {{model}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "barAlignment": -1,
            "showPoints": "never",
            "spanNulls": false,
            "gradientMode": "none",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "$bucket",
      "id": 1
    },
