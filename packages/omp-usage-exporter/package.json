{
  "name": "@tommasomarchionni/omp-usage-exporter",
  "version": "0.2.0",
  "description": "Node.js service that imports OMP usage events and exposes Prometheus metrics",
  "type": "module",
  "license": "MIT",
  "author": "Tommaso Marchionni",
  "repository": {
    "type": "git",
    "url": "https://github.com/tommasomarchionni/omp-usage.git",
    "directory": "packages/omp-usage-exporter"
  },
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "bin": {
    "omp-usage-exporter": "./dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --pool=threads --maxWorkers=1",
    "lint": "eslint src --ext .ts",
    "typecheck": "npm run build --workspace=@tommasomarchionni/omp-usage-protocol && tsc --noEmit",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@prometheus-io/client": "^0.16.1",
    "better-sqlite3": "^13.0.0",
    "commander": "^15.0.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
