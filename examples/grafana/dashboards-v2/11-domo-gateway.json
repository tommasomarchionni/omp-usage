{
  "uid": "domo-gateway",
  "title": "11 - Gateway Kong",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "tags": ["domotommy", "provisioned", "ai-observability"],
  "timezone": "Europe/Rome",
  "refresh": "30s",
  "time": {
    "from": "now/d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Richieste/s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service)(rate(kong_http_requests_total{job=\"kong\"}[5m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Traffico HTTP attraverso Kong; non coincide con richieste LLM OMP. "
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Risposte per codice: ultime 1h",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service,code)(increase(kong_http_requests_total{job=\"kong\"}[1h]))",
          "legendFormat": "{{service}} / {{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
