    {
      "type": "timeseries",
      "title": "Equivalent $ per 1M tokens",
      "description": "Blended price given each model's mix of input/output/cache",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (provider, model) (\n  increase(omp_llm_tokens_total{job=~\"$job\", provider=~\"$provider\", model=~\"$model\"}[$__interval])\n  * on (provider, model, direction) group_left\n  max by (provider, model, direction) (omp_llm_price_usd_per_million_tokens{job=~\"$job\"})\n) / 1e6\n/\nsum by (provider, model) (increase(omp_llm_tokens_total{job=~\"$job\", provider=~\"$provider\", model=~\"$model\"}[$__interval])) * 1e6",
          "legendFormat": "{{provider}} / {{model}}",
