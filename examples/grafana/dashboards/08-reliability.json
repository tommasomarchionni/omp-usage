          "editorMode": "code",
          "expr": "sum by (status) (increase(omp_llm_requests_total{job=~\"$job\", provider=~\"$provider\", model=~\"$model\"}[$__interval]))",
          "legendFormat": "{{status}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
