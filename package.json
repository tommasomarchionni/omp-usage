{
  "name": "omp-usage",
  "version": "0.1.0",
  "private": true,
  "description": "OMP usage tracking plugin and Prometheus exporter",
  "repository": {
    "type": "git",
    "url": "https://github.com/tommasomarchionni/omp-usage.git"
  },
  "author": "Tommaso Marchionni",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@tommasomarchionni/omp-usage-protocol && npm run build --workspace=@tommasomarchionni/omp-usage && npm run build --workspace=@tommasomarchionni/omp-usage-exporter",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "pack": "npm pack --workspaces --ignore-scripts",
    "docs:serve": "mkdocs serve -f docs/mkdocs.yml",
    "docs:build": "mkdocs build -f docs/mkdocs.yml --strict",
    "test:integration": "npm run test:integration --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
