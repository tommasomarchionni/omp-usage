  "panels": [
    {
      "id": 1,
      "title": "Richieste OMP",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sum by (provider,model) (increase(omp_llm_requests_total{job=~\"$job\",provider=~\"$provider\",model=~\"$model\"}[$__range])))",
          "instant": true,
          "range": false,
          "legendFormat": "{{provider}} / {{model}}",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "N/D"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
