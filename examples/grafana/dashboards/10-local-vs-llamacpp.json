{
  "uid": "omp-usage-local",
  "title": "OMP usage / Local models vs llama.cpp",
  "description": "OMP usage of local providers next to the llama.cpp server metrics, compared without summing.",
  "tags": [
    "omp-usage"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "links": [
    {
      "title": "OMP usage",
      "type": "dashboards",
      "tags": [
        "omp-usage"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "label": "Data source",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "type": "query",
        "name": "job",
        "label": "Job",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(omp_usage_build_info, job)",
        "query": {
          "query": "label_values(omp_usage_build_info, job)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "sort": 1,
        "hide": 0,
        "regex": "",
        "options": [],
        "current": {
          "text": "omp_usage",
          "value": "omp_usage"
        }
      },
      {
        "type": "query",
        "name": "local_provider",
        "label": "Local providers",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(omp_llm_tokens_total{job=~\"$job\"}, provider)",
        "query": {
          "query": "label_values(omp_llm_tokens_total{job=~\"$job\"}, provider)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": false,
        "sort": 1,
        "hide": 0,
        "regex": "",
        "options": [],
        "current": {
          "text": "llama.cpp",
          "value": "llama.cpp"
        }
      },
      {
        "type": "textbox",
        "name": "llm_job",
        "label": "llama.cpp job",
        "query": "llm",
        "description": "Prometheus job of the llama.cpp server (--metrics)",
        "current": {
          "text": "llm",
          "value": "llm"
        },
        "hide": 0,
        "options": [
          {
            "selected": true,
            "text": "llm",
            "value": "llm"
          }
        ]
      },
      {
        "type": "interval",
        "name": "bucket",
        "label": "Bucket",
        "query": "1h,3h,6h,12h,1d,7d,30d",
        "auto": false,
        "auto_count": 30,
        "auto_min": "1h",
        "refresh": 2,
        "hide": 0,
        "current": {
          "text": "1h",
          "value": "1h"
        },
        "options": [
          {
            "text": "1h",
            "value": "1h",
            "selected": true
          },
          {
            "text": "3h",
            "value": "3h",
            "selected": false
          },
          {
            "text": "6h",
            "value": "6h",
            "selected": false
          },
          {
            "text": "12h",
            "value": "12h",
            "selected": false
          },
          {
            "text": "1d",
            "value": "1d",
            "selected": false
          },
          {
            "text": "7d",
            "value": "7d",
            "selected": false
          },
          {
            "text": "30d",
            "value": "30d",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "Never add these numbers",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "The same generation can appear **twice**: once in OMP (`job=$job`, provider $local_provider) and once in the llama.cpp server metrics (`job=$llm_job`). Other clients of llama.cpp (Open WebUI, scripts) are only in llama.cpp. The panels compare the two sources side by side and as **ratios**, never as sums. llama.cpp metrics have no model label: one server = one model."
      },
      "id": 1
    },
    {
      "type": "row",
      "title": "Side by side (per bucket)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Prompt tokens: OMP vs llama.cpp",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(increase(omp_llm_tokens_total{job=~\"$job\", provider=~\"$local_provider\", direction=~\"input|cache_write\"}[$__interval]))",
          "legendFormat": "OMP input + cache write",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(increase(omp_llm_tokens_total{job=~\"$job\", provider=~\"$local_provider\", direction=\"cache_read\"}[$__interval]))",
          "legendFormat": "OMP cache read",
          "refId": "B",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(increase({__name__=\"llamacpp:prompt_tokens_total\", job=~\"$llm_job\"}[$__interval]))",
          "legendFormat": "llama.cpp prompt (processed)",
          "refId": "C",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(increase({__name__=\"llamacpp:prompt_tokens_cached_total\", job=~\"$llm_job\"}[$__interval]))",
          "legendFormat": "llama.cpp prompt (cached)",
          "refId": "D",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "barAlignment": -1,
            "showPoints": "never",
            "spanNulls": false,
            "gradientMode": "none",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "$bucket",
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Generated tokens: OMP output vs llama.cpp predicted",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
