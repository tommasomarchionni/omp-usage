      },
      "options": {
        "mode": "markdown",
        "content": "Prices **all** selected usage (any provider) at the price of each reference model from the `references` list of the pricing file. Token counts come from the original models' tokenizers, so this is an estimate, not a quote."
      },
      "id": 1
    },
    {
      "type": "bargauge",
      "title": "Cost of the selected usage at each reference model",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (reference_model) (\n  sum by (direction) (increase(omp_llm_tokens_total{job=~\"$job\", provider=~\"$provider\", model=~\"$model\"}[$__range]))\n  * on (direction) group_right\n  max by (reference_model, direction) (omp_llm_reference_price_usd_per_million_tokens{job=~\"$job\", reference_model=~\"$reference\"})\n) / 1e6",
          "legendFormat": "{{reference_model}}",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "continuous-BlYlRd"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
