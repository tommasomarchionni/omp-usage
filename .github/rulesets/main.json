{
  "name": "Protect main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] }
  },
  "bypass_actors": [],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    { "type": "required_linear_history" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["squash"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          { "context": "Lint & TypeCheck" },
          { "context": "Conventional PR title" },
          { "context": "Test (ubuntu-latest, Node 22)" },
          { "context": "Test (ubuntu-latest, Node 24)" },
          { "context": "Test (macos-latest, Node 22)" },
          { "context": "Test (macos-latest, Node 24)" },
          { "context": "Package smoke (ubuntu-latest)" },
          { "context": "Package smoke (macos-latest)" },
          { "context": "npm audit (production dependencies)" },
          { "context": "Docs build" },
          { "context": "Analyze (javascript-typescript)" },
          { "context": "Analyze (actions)" }
        ]
      }
    }
  ]
}
